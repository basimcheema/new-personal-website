---
const { title = "Basim" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <div class="site-links">
          <a href="/">home</a>
          <a href="/about/">about</a>
          <a href="/experience/">experience</a>
          <a href="/projects/projects">projects</a>
          <a href="/photos/">photos</a>
        </div>

        <div class="profile-links">
          <a href="https://www.linkedin.com/in/basim-cheema-sabir/" target="_blank" rel="noreferrer">linkedin</a>
          <a href="https://github.com/basimcheema" target="_blank" rel="noreferrer">github</a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
            <img id="theme-icon" src="/icons/moon.svg" alt="" />
            </button>

        </div>
      </nav>
    </header>

    <slot />

    <footer>
      <p>Last updated 2026.</p>
    </footer>

    <script>
    const themeToggle = document.querySelector("#theme-toggle");
    const themeIcon = document.querySelector("#theme-icon");
    const savedTheme = localStorage.getItem("theme");

    function setTheme(theme) {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem("theme", theme);

        if (themeIcon) {
        themeIcon.src = theme === "dark" ? "/icons/sun.svg" : "/icons/moon.svg";
        }

        if (themeToggle) {
        themeToggle.setAttribute(
            "aria-label",
            theme === "dark" ? "Switch to light mode" : "Switch to dark mode"
        );
        }
    }

    setTheme(savedTheme === "dark" ? "dark" : "light");

    themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.dataset.theme === "dark";
        setTheme(isDark ? "light" : "dark");
    });
    </script>
  </body>
</html>

<style>
:global(html) {
    font-family: Tahoma;
    line-height: 1.55;
}

  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    --page-width: min(75%, 800px);
    --page-padding: 2.4%;
    --space-xs: max(0.8%, 6px);
    --space-sm: max(1.2%, 10px);
    --space-md: max(3.2%, 20px);
    --space-lg: max(4.8%, 32px);
  }

  :global(html[data-theme="light"]) {
    background: #dddcce;
    color: #303030;

    footer {
    border-top: 1px solid #303030;
    color: #303030;
  }

  header {
    border-bottom: 1px solid #303030;
  }

  }

  :global(html[data-theme="dark"]) {
    background: #282828;
    color: #e3e3e3;

    footer {
    border-top: 1px solid #e3e3e3;
    color: #e3e3e3;
  }

  header {
    border-bottom: 1px solid #e3e3e3;
  }

  }

    .theme-toggle {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: 0;
    }

    .theme-toggle img {
    display: block;
    width: 18px;
    height: 18px;
    }


  body {
    width: var(--page-width);
    margin: 0 auto;
    padding: var(--page-padding);
  }

  header {
    border-bottom: 1px solid #111;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
  }

  nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-xs);
  }

  .site-links,
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }

  a {
    color: #0645ad;
  }


  :global(html[data-theme="dark"]) a {
    color: #8ab4ff;
  }

  h1,
  h2 {
    line-height: 1.1;
  }

  footer {
    font-size: 0.9rem;
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
  }
</style>
